{
  "name": "cpa-model-switcher",
  "version": "0.6.2",
  "description": "Independent Codex main and subagent model switcher for CPA providers",
  "main": "src/main.cjs",
  "author": "MDSD",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm test && node scripts/dist.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "npm test && node scripts/dist.cjs darwin",
    "dist:win": "npm test && node scripts/dist.cjs win32",
    "checksums": "node scripts/checksums.cjs",
    "smoke:packaged": "node scripts/packaged-smoke.cjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.mdsd.cpa-model-switcher",
    "productName": "CPA Model Switcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CPA-Model-Switcher-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "CPA-Model-Switcher-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "CPA Model Switcher",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
